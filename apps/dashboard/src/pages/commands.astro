---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// Command list data — audited against mod source in berongsmp-template-26.1.2
// (command/RegistrationCommands.java, ItemCommands.java, SimulationCommands.java,
// BfpAdminCommands.java) as of the /bfp new_tutorial skipto commit (8540c0a).
const commands = [
  {
    name: '/register',
    category: 'registration',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/register <student_id> <section> <full_name>',
    arguments: [
      { name: 'student_id', type: 'word', range: 'N/A', required: 'Yes', description: 'Single-token student ID.' },
      { name: 'section', type: 'word', range: 'N/A (no hyphens, e.g. BSCS3A)', required: 'Yes', description: 'Single-token section code.' },
      { name: 'full_name', type: 'string', range: 'N/A', required: 'Yes', description: 'Rest of the line — the student\'s full name (can contain spaces).' }
    ],
    description: 'Registers the calling player as a student before they can pass the lobby gates and start the tutorial.',
    whatHappens: [
      'Calls RegistrationManager.register(player, studentId, section, fullName).',
      'Calls SessionManager.checkin(uuid, minecraftName, fullName) — opens a session row.',
      'Writes student_id/section to Turso via TursoClient.updateStudentInfo.',
      'Chat confirms registration and that the tutorial may begin.'
    ],
    notes: [
      'Player-only — no-op from console.',
      'This is the first gate in LobbyManager.gatesPassed — simulation buttons stay inactive until it succeeds.'
    ]
  },
  {
    name: '/sim_fire',
    category: 'simulation',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/sim_fire <library|ccs>',
    arguments: [
      { name: 'target', type: 'string', range: 'library | ccs', required: 'Yes', description: '"library" starts the drill in the LSPU Library (ABC extinguisher given, state FIRE). "ccs" starts in the CCS Admin Building (CO2 extinguisher given, state CCS_FIRE).' }
    ],
    description: 'Starts a Fire simulation immediately, bypassing the lobby button. Choose the target building.',
    whenToUse: [
      'Testing the fire simulation without walking to the lobby button.',
      'Admin/instructor drops a student into a fire drill in a specific building.'
    ],
    whatHappens: [
      'All three structures placed (LSPU Library, SSC Building, CCS Admin Building).',
      'Player is teleported to a random valid room inside the chosen building.',
      'ABC extinguisher (library) or CO2 extinguisher (ccs) given in hotbar slot 0.',
      'Fire blocks begin spawning every fireSpawnInterval ticks.',
      'Timer counts down from simDurationTicks.',
      'HUD displays "SIMULATION STATUS: FIRE" (library) or "SIMULATION STATUS: CCS_FIRE".'
    ],
    notes: [
      'No OP requirement in source — any player can run this directly, not just admins.',
      'Bare "/sim_fire" with no argument fails with a usage hint.',
      'Fails if you already have a simulation running.',
      'Player-only — cannot be run from the server console.'
    ]
  },
  {
    name: '/sim_earthquake',
    category: 'earthquake',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/sim_earthquake <library|ccs> [magnitude]',
    arguments: [
      { name: 'target', type: 'string', range: 'library | ccs', required: 'Yes', description: '"library" runs the drill in the LSPU Library (state EARTHQUAKE); "ccs" runs it in the CCS Admin Building (state CCS_EARTHQUAKE).' },
      { name: 'magnitude', type: 'double', range: '0.1 - 10.0', required: 'No', description: 'Quake intensity. If omitted: library uses quakeMagnitude from config (default 5.0); ccs instead rolls a random magnitude 6.0-9.5.' }
    ],
    description: 'Starts an Earthquake simulation immediately. Choose the building and optional magnitude.',
    whenToUse: [
      'Testing the earthquake simulation without the lobby button.',
      'Running a controlled drill at a specific intensity.',
      'Instructors scripting a lesson with a predictable magnitude.'
    ],
    whatHappens: [
      'All structures placed (LSPU Library, SSC Building, CCS Admin Building).',
      'Epicenter fixed 3-9 blocks from the chosen building interior so destruction stays inside.',
      'Player teleported to a random valid room inside the target building.',
      'Chat: "Magnitude X.X Earthquake has begun!"',
      'Phase machine: RUMBLE (200 ticks / 10s) -> PEAK (900 ticks / 45s) -> AFTERSHOCK x2-4 waves (300 ticks / 15s each) -> END.',
      'Aftershocks use random magnitude scales (0.2-1.1x base) before finally ending.',
      'Nausea applied per phase; camera shake driven by per-player intensity = magnitude x e^(-decayRate x distance).',
      'HUD shows "SIMULATION STATUS: EARTHQUAKE" or "CCS_EARTHQUAKE" and an intensity bar.'
    ],
    notes: [
      'No OP requirement in source — any player can run this directly, not just admins.',
      'Lobby button always starts at a random magnitude 6.0-9.5 (strong range) regardless of building.',
      'Fails if you already have an active simulation.'
    ]
  },
  {
    name: '/sim_magnitude',
    category: 'earthquake',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/sim_magnitude <value>',
    arguments: [
      { name: 'value', type: 'double', range: '0.1 – 10.0', required: 'Yes', description: 'New magnitude value.' }
    ],
    description: 'Changes the magnitude of your currently active earthquake session live, taking effect on the very next tick.',
    whenToUse: [
      'Instructor wants to dial up intensity mid-session to demonstrate a stronger quake.',
      'Gradually increase magnitude as a teaching progression without stopping and restarting.',
      'Dial back an accidental high-magnitude start so players aren\'t overwhelmed.'
    ],
    examples: [
      { cmd: '/sim_earthquake library 3.0', desc: 'Start mild for explanation' },
      { cmd: '/sim_magnitude 6.0', desc: 'Escalate during PEAK phase for impact' },
      { cmd: '/sim_magnitude 9.0', desc: 'Push to severe for demonstration' },
      { cmd: '/sim_stop', desc: 'End simulation when done' }
    ],
    notes: [
      'Fails with "No active earthquake simulation to adjust." if you have no running earthquake session.',
      'Restricted to ops (LEVEL_GAMEMASTERS) — regular players cannot use this, unlike /sim_earthquake itself.'
    ]
  },
  {
    name: '/sim_stop',
    category: 'simulation',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/sim_stop',
    description: 'Ends your active simulation early. Behaves identically to the timer expiring naturally.',
    whenToUse: [
      'Ending a drill early (session went wrong, player is stuck, admin intervention).',
      'Resetting the arena to a clean state before starting a new session.'
    ],
    whatHappens: [
      'Active session is removed.',
      'LSPU Library + SSC Building structures are restored to their original state.',
      'HUD is cleared.',
      'Player is teleported back to the lobby spawn.',
      'If it was a FIRE session, score is printed: fires extinguished and score out of 100.'
    ],
    notes: [
      'Safe to call even if no simulation is running (no-op).',
      'Player-only in source — the console form always prints "Simulation stopped." even though there is no session to stop for a non-player source.',
      'If the player died during the simulation, the structure is still restored but the teleport is deferred to their next respawn.'
    ]
  },
  {
    name: '/bfp login',
    category: 'bfp-admin',
    permission: 'Any Player (PIN required)',
    permissionLevel: 'admin',
    syntax: '/bfp login <pin>',
    arguments: [
      { name: 'pin', type: 'word', range: 'N/A', required: 'Yes', description: 'Admin authentication PIN set in bfpAdminPin config (blank by default — PIN login disabled until set).' }
    ],
    description: 'Authenticates you as a BFP admin for this session using the configured PIN.',
    whatHappens: [
      'Authenticates the user as BFP admin for the current session (added to the in-memory bfpAuthorized set).',
      'All /bfp sub-commands become available until logout or server restart.'
    ],
    notes: [
      'OPs always bypass the PIN check (LEVEL_GAMEMASTERS satisfies isBfpAuthorized without logging in).',
      '5 wrong attempts triggers a 5-minute lockout for that player (per-UUID).',
      'Fails immediately if bfpAdminPin is left blank in config.',
      'Ensure you change the default blank PIN in the config before going live.'
    ]
  },
  {
    name: '/bfp logout',
    category: 'bfp-admin',
    permission: 'Any Player (Authenticated)',
    permissionLevel: 'admin',
    syntax: '/bfp logout',
    description: 'Revokes your PIN-based BFP admin access.',
    whenToUse: [
      'Step away from the station so others cannot run admin commands on your account.'
    ]
  },
  {
    name: '/bfp checkin',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp checkin <student_name> | /bfp checkin <player> <student_name>',
    arguments: [
      { name: 'student_name', type: 'string', range: 'N/A', required: 'Yes', description: 'Full name of the student checking in.' },
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player account if different from the caller.' }
    ],
    description: 'Starts a new session for a student sitting at the station.',
    whatHappens: [
      'Any existing session for that account is closed and saved.',
      'Tutorial saved data for the account UUID is wiped (fresh start).',
      'A new row is inserted into Turso with status="active".'
    ],
    examples: [
      { cmd: '/bfp checkin Juan dela Cruz', desc: 'Starts session for caller as Juan dela Cruz' },
      { cmd: '/bfp checkin station2 Maria Santos', desc: 'Starts session for player "station2" as Maria Santos' }
    ]
  },
  {
    name: '/bfp checkout',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp checkout',
    description: 'Finalises the calling player\'s current session and writes results to the database.',
    whatHappens: [
      'Writes end_time and status="completed" to Turso.',
      'Useful when a student finishes and leaves without triggering a simulation end.'
    ],
    notes: [
      'Self only — there is no [player] target argument on this command.'
    ]
  },
  {
    name: '/bfp reset',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp reset [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player to reset. Defaults to caller if omitted.' }
    ],
    description: 'Wipes tutorial state and deletes the active DB row — no record is kept.',
    whenToUse: [
      'Use when a session was started by mistake or needs to be discarded.'
    ],
    notes: [
      'This resets the OLD tutorial (TutorialSavedData). For the Academy, use /bfp new_tutorial or /bfp new_tutorial skipto instead.',
      'Permanently deletes the DB row — there is no undo. Use /bfp checkout first if you want to keep the record.'
    ]
  },
  {
    name: '/bfp tutorial',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp tutorial [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player to reset. Defaults to caller if omitted.' }
    ],
    description: 'Resets a player\'s OLD tutorial state and immediately teleports them to the old tutorial lobby.',
    whatHappens: [
      'Wipes the tutorial save (SessionManager.resetTutorialOnly) and any active session.',
      'Tutorial NPCs are re-initialised at their correct positions via TutorialLobbyManager.initNpcs (fixes any duplicates).',
      'Target player is teleported to TutorialLobbyManager.TSPAWN_X/Y/Z.'
    ],
    notes: [
      'Distinct from /bfp new_tutorial — this is the legacy TutorialManager flow, not the Academy.'
    ]
  },
  {
    name: '/bfp new_tutorial',
    category: 'academy',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp new_tutorial [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller if omitted.' }
    ],
    description: 'Activates the Academy exactly like /bfp tutorial activates the old tutorial — wipes Academy progress back to a fresh start and teleports to Room 1 (Officer Cruz).',
    whatHappens: [
      'AcademySavedData.reset(uuid) — full wipe of AcademyProgress for the target.',
      'AcademyManager.cancelDialogue + clearTransientState for the target.',
      'CruzRoomManager.resetCruz — snaps the Officer Cruz NPC back to her briefing anchor.',
      'ReyesRoomManager.restockExtinguisherFrames — refills the Tool Selection Wall.',
      'Teleports target to the "officer_cruz" viewpoint (Room 1 default).',
      'Chat: "Academy progress reset for <name> — teleported back to Room 1."'
    ],
    notes: [
      'Bare form and /bfp new_tutorial reset are identical — reset is just a more discoverable alias.'
    ]
  },
  {
    name: '/bfp new_tutorial reset',
    category: 'academy',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp new_tutorial reset [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller if omitted.' }
    ],
    description: 'Explicit, discoverable alias for the exact same reset-and-teleport the bare /bfp new_tutorial performs.',
    whenToUse: [
      'When you want a self-documenting command in a script or chat macro instead of the bare form.'
    ]
  },
  {
    name: '/bfp new_tutorial <viewpoint>',
    category: 'academy',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp new_tutorial <officer_cruz|sgt_reyes|sgt_santos|capt_morfe> [player]',
    arguments: [
      { name: 'viewpoint', type: 'literal', range: 'officer_cruz | sgt_reyes | sgt_santos | capt_morfe', required: 'Yes', description: 'One literal subcommand per entry in AcademyBuildingManager.VIEWPOINTS — a pure dev-navigation teleport, no reset.' },
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller if omitted.' }
    ],
    description: 'Teleports straight to an F3-captured reference viewpoint inside the Academy building — for tuning NPC placement, no progress change.',
    detailsLabel: 'Named viewpoints (world coords):',
    details: [
      'officer_cruz — (-148.570, -33.0, 32.248), yaw 88.3, pitch 0 — Room 1, Extinguisher Types section, faces Officer Cruz\'s NPC. Also the DEFAULT_VIEWPOINT used by the bare reset form.',
      'sgt_reyes — (-172.5, -33.0, 17.5), yaw/pitch 0 — Room 2 NPC anchor.',
      'sgt_santos — (-170.5, -33.0, 33.5), yaw/pitch 0 — Room 3 NPC anchor.',
      'capt_morfe — (-108.5, -33.0, 77.5), yaw/pitch 0 — Room 4 NPC anchor.'
    ],
    notes: [
      'Chat: "Teleported <name> to the new tutorial building."',
      'Does not touch AcademyProgress — use /bfp new_tutorial skipto to jump in with a clean, consistent room state.'
    ]
  },
  {
    name: '/bfp new_tutorial skipto',
    category: 'academy',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp new_tutorial skipto <cruz|reyes|santos|morfe> [player]',
    arguments: [
      { name: 'instructor', type: 'literal', range: 'cruz | reyes | santos | morfe', required: 'Yes', description: 'Which room to jump straight into. Every room strictly before it is marked DONE; the target room and everything after is reset to NOT_STARTED.' },
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller if omitted.' }
    ],
    description: 'Dev shortcut to jump straight into any Academy room without replaying every prior one by hand.',
    whenToUse: [
      'QA-testing one room in isolation (e.g. only Sgt. Santos\'s STOP/GO drill) without redoing Rooms 1-2 every time.',
      'Demoing a specific instructor to visitors without the full walkthrough.'
    ],
    whatHappens: [
      'AcademyManager.cancelDialogue + clearTransientState for the target.',
      'AcademyProgress.resetAll() — resets every room to NOT_STARTED — then marks rooms strictly before the target instructor DONE.',
      'CruzRoomManager.resetCruz — Cruz snapped back to her anchor.',
      'ReyesRoomManager.restockExtinguisherFrames — extinguisher wall refilled.',
      'ReyesRoomManager.cleanupHazardProps — leftover Room 2 hazard props cleared (unique to skipto; the plain reset/bare form does not do this).',
      'Teleports target to the chosen instructor\'s viewpoint.',
      'Chat: "Academy progress set to start <instructor> for <name> — teleported there."'
    ],
    detailsLabel: 'Instructor -> what gets marked DONE:',
    details: [
      'skipto cruz — nothing marked done (equivalent to a full /bfp new_tutorial reset).',
      'skipto reyes — Room 1 (Cruz) marked DONE.',
      'skipto santos — Rooms 1-2 (Cruz, Reyes) marked DONE.',
      'skipto morfe — Rooms 1-3 (Cruz, Reyes, Santos) marked DONE.'
    ],
    notes: [
      'Added in commit 8540c0a as a debug command for faster iteration on later rooms.'
    ]
  },
  {
    name: '/bfp session info',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp session info',
    description: 'Prints the current session details to chat.',
    details: [
      'Student name & station account',
      'Session start time',
      'Whether the tutorial is complete',
      'Simulation type, score, and pass/fail status'
    ],
    notes: [
      'Self only — no [player] target argument.'
    ]
  },
  {
    name: '/bfp sessions list',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp sessions list [page]',
    arguments: [
      { name: 'page', type: 'integer', range: '1+', required: 'No', description: 'Page number for pagination.' }
    ],
    description: 'Lists the 10 most recent sessions from Turso in chat, paginated.',
    details: [
      'Each entry shows student name, account, simulation type, score, pass status, and session status.'
    ]
  },
  {
    name: '/bfp sessions export',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp sessions export',
    description: 'Queries all sessions from Turso and writes them to bfp_sessions_export.csv in the server working directory.',
    details: [
      'Columns exported: id, student_name, station_account, account_uuid, start_time, end_time, status, tutorial_completed, tutorial_duration_s, simulation_type, simulation_score, passed, notes'
    ]
  },
  {
    name: '/bfp student',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp student <name>',
    arguments: [
      { name: 'name', type: 'string', range: 'N/A', required: 'Yes', description: 'Exact student name to search (matched exactly, not partial).' }
    ],
    description: 'Looks up the last 10 sessions for a given student name and prints them to chat.',
    whenToUse: [
      'Checking a student\'s history across multiple attempts.'
    ]
  },
  {
    name: '/sim_status',
    category: 'simulation',
    permission: 'Player (self) / Op Level 2+ (target)',
    permissionLevel: 'admin',
    syntax: '/sim_status [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller. Only the targeted form requires OP — checking your own status is open to any player.' }
    ],
    description: 'Prints a live snapshot of the target player\'s simulation: type, phase, time remaining, fires extinguished.',
    whenToUse: ['Instructor monitoring a student\'s session in real time.'],
    notes: [
      'Also reports the frozen flag and quake phase (if quake type and phase != null).'
    ]
  },
  {
    name: '/sim_list',
    category: 'simulation',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/sim_list',
    description: 'Lists all currently active simulations across every online player.',
    whenToUse: ['Overview of who is in a drill when multiple stations are running simultaneously.']
  },
  {
    name: '/sim_freeze',
    category: 'simulation',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/sim_freeze [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Pauses the simulation timer without stopping effects (fire/quake still ticks). Good for pausing to give instruction.',
    notes: [
      'Gated to OP for both the bare and targeted forms — unlike /sim_status, even freezing your own session requires OP.',
      'Resume with /sim_unfreeze.'
    ]
  },
  {
    name: '/sim_unfreeze',
    category: 'simulation',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/sim_unfreeze [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Resumes a frozen simulation timer.',
    whenToUse: ['After /sim_freeze, when ready to continue the timed session.']
  },
  {
    name: '/sim_time',
    category: 'simulation',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/sim_time set <seconds> | /sim_time add <seconds>',
    arguments: [
      { name: 'set/add', type: 'string', range: 'set | add', required: 'Yes', description: '"set" replaces remaining time (0-3600s); "add" adds or subtracts seconds (-3600 to 3600), clamped to a minimum of 0.' },
      { name: 'seconds', type: 'integer', range: 'set: 0-3600, add: -3600 to 3600', required: 'Yes', description: 'Seconds to set or offset.' }
    ],
    description: 'Adjusts the remaining simulation time on the fly.',
    examples: [
      { cmd: '/sim_time set 60', desc: 'Give student exactly 1 minute left' },
      { cmd: '/sim_time add -30', desc: 'Subtract 30 seconds (urgency drill)' },
      { cmd: '/sim_time add 120', desc: 'Add 2 minutes for a struggling student' }
    ],
    notes: [
      'Unlike /sim_status, /sim_freeze, and /sim_unfreeze, there is no [player] target argument — this only ever operates on the invoking player\'s own active session.'
    ]
  },
  {
    name: '/bfp bypass',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp bypass on [player] | /bfp bypass off [player]',
    arguments: [
      { name: 'on/off', type: 'string', range: 'on | off', required: 'Yes', description: 'Enable or disable bypass mode.' },
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Skips lobby gates (registration, session check, tutorial) for quick testing. Resets on server restart.',
    whenToUse: ['Dev/testing to jump straight into a simulation without going through the tutorial flow.']
  },
  {
    name: '/bfp note',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp note <text>',
    arguments: [
      { name: 'text', type: 'string', range: 'N/A', required: 'Yes', description: 'Observation text to append to the session.' }
    ],
    description: 'Appends an instructor observation note to the active session\'s bfp_notes column in Turso.',
    whenToUse: ['Recording on-the-fly behavioural observations during a drill.'],
    notes: [
      'Self only — no [player] target argument. Fails if you have no active session.'
    ]
  },
  {
    name: '/bfp confidence',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp confidence <1-5>',
    arguments: [
      { name: 'rating', type: 'double', range: '1.0 – 5.0', required: 'Yes', description: 'Instructor-assessed confidence level (1 = very low, 5 = very high).' }
    ],
    description: 'Sets the instructor confidence rating for the active session.',
    whenToUse: ['After observing a student — rate their perceived readiness/composure.'],
    notes: ['Self only — no [player] target argument.']
  },
  {
    name: '/bfp prep_level',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp prep_level <none|low|moderate|high>',
    arguments: [
      { name: 'level', type: 'literal', range: 'none | low | moderate | high', required: 'Yes', description: 'Instructor assessment of preparedness level (four fixed subcommands, not a free string).' }
    ],
    description: 'Records the instructor\'s preparedness assessment in the session row.',
    whenToUse: ['After a drill — qualitative complement to the numeric score.'],
    notes: ['Self only — no [player] target argument.']
  },
  {
    name: '/bfp score',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp score <0-100> [player]',
    arguments: [
      { name: 'score', type: 'integer', range: '0–100', required: 'Yes', description: 'Override score to assign.' },
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Manually overrides the simulation score for a session.',
    notes: ['The automatic score is calculated from fires extinguished / threshold. Use this to adjust for rubric factors.']
  },
  {
    name: '/bfp pass',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp pass [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Marks the active session as passed (passed=1) in the database.',
    whenToUse: ['Override when the auto pass/fail logic does not match instructor judgement.']
  },
  {
    name: '/bfp fail',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp fail [player]',
    arguments: [
      { name: 'player', type: 'player', range: 'Online players', required: 'No', description: 'Target player. Defaults to caller.' }
    ],
    description: 'Marks the active session as failed (passed=0) in the database.',
    whenToUse: ['Override pass status when a student fails on non-score criteria.']
  },
  {
    name: '/bfp sessions today',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp sessions today',
    description: 'Lists all sessions started today from Turso.',
    whenToUse: ['End-of-day summary or checking who has gone through the drill today.']
  },
  {
    name: '/bfp sessions stats',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp sessions stats',
    description: 'Prints aggregate statistics: total sessions, pass rate, average score, fire vs earthquake breakdown.',
    whenToUse: ['Instructor reporting; quick top-line numbers without opening the dashboard.'],
    notes: ['Fails if Turso is not configured (TursoClient.isReady() false).']
  },
  {
    name: '/bfp sessions search',
    category: 'bfp-admin',
    permission: 'Op or PIN Admin',
    permissionLevel: 'admin',
    syntax: '/bfp sessions search <query>',
    arguments: [
      { name: 'query', type: 'string', range: 'N/A', required: 'Yes', description: 'Partial student name or station account to search (LIKE %query%, up to 15 results).' }
    ],
    description: 'Searches sessions by student name or station account (partial match).',
    whenToUse: ['Locating a specific student\'s records without knowing their exact station.']
  },
  {
    name: '/get_extinguisher',
    category: 'utility',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/get_extinguisher',
    description: 'Gives an ABC dry-chemical Fire Extinguisher directly into your inventory.',
    whenToUse: [
      'You dropped or lost the extinguisher during a fire simulation.',
      'Testing extinguisher mechanics outside of a simulation.',
      'Demonstrating the PASS technique before a drill.'
    ],
    notes: [
      'Pin starts NOT pulled. Right-click to pull the pin (P in PASS), then right-click again to spray.',
      '300 durability. Can be used any time.'
    ]
  },
  {
    name: '/get_co2_extinguisher',
    category: 'utility',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/get_co2_extinguisher',
    description: 'Gives a CO2 extinguisher for Class C (electrical) fires directly into your inventory.',
    whenToUse: [
      'Testing CO2 extinguisher against a ComputerBlock with BURNING=true during a CCS_FIRE simulation.',
      'Demonstrating the difference between ABC and CO2 extinguishers.'
    ],
    notes: [
      'Targets ComputerBlock (BURNING→BROKEN). Also suppresses regular fire/soul fire.',
      '200 durability.'
    ]
  },
  {
    name: '/get_wet_chemical_extinguisher',
    category: 'utility',
    permission: 'Any Player',
    permissionLevel: 'player',
    syntax: '/get_wet_chemical_extinguisher',
    description: 'Gives a yellow wet chemical extinguisher for Class F/K (cooking-oil/grease) fires directly into your inventory.',
    whenToUse: [
      'Testing the wet chemical unit against the five cafeteria/kitchen hazard props (deep fryer, grease pan, range hood, panini press, kitchen bin) plus the leaking gas valve.',
      'Demonstrating the Philippine BFP yellow colour-coding for kitchen fires alongside the red ABC and green CO2 units.'
    ],
    notes: [
      'Also suppresses regular fire/soul fire and defuses any hazard prop, but gives distinct "saponification complete" feedback on kitchen hazard props.',
      '240 durability. Not auto-issued at simulation start — no dedicated kitchen scenario yet.'
    ]
  },
  {
    name: '/item hazard',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/item hazard <name>',
    arguments: [
      { name: 'name', type: 'word', range: 'see list below', required: 'Yes', description: 'Registry name of the hazard prop block to give. Tab-completes all 30 names from ModItems.HAZARD_ITEM_MAP.' }
    ],
    description: 'Gives a hazard prop block item by registry name — the subset of /item get covering only the 30 hazard props. Use for building or decorating hazard scenarios.',
    whenToUse: [
      'Building or decorating a training facility scenario with realistic hazard props.',
      'Testing a specific hazard block\'s particle effects and light level.',
      'Placing blocks in normal (hazardous=false) or hazardous (hazardous=true via /setblock) states.'
    ],
    detailsLabel: 'All 30 hazard block names (tab-completes in-game):',
    details: [
      'plastic_trash_bin — classroom bin with vape; smoke when hazardous',
      'daisy_chain_extension — overloaded extension cord; electric sparks',
      'woodshop_sawdust_layer — floor sawdust 0–5 accumulation; ash at level 3+',
      'stage_spotlight — overheating theatre light; flame + smoke; light 10',
      'archive_box_stack — flammable document boxes; campfire smoke',
      'dust_choked_pc — PC tower with blocked vents; smoke; light 3',
      'charging_cart — rolling Chromebook cart; electric sparks; light 5',
      'frayed_console_wire — floor AV cable with bare copper; sparks + soul flame',
      'malfunctioning_vending — shorted vending machine; smoke',
      'ceiling_projector — overheating ceiling projector; smoke + lava; light 7',
      'swollen_phone_battery — thermally swollen phone; soul flame gas',
      'damaged_lipo_pack — punctured drone LiPo; campfire smoke',
      'vape_in_iron_locker — locker with vaping device; sparks + smoke',
      'pa_system_backup — PA amp rack with faulty caps; lava sparks; light 8',
      'smartboard_inverter — water-damaged smartboard; water drip particles',
      'unattended_grease_pan — grease fire on stove; flame + smoke; light 10',
      'grease_clogged_hood — kitchen range hood; large smoke (ceiling-mounted)',
      'contaminated_kitchen_bin — oil-rag bin; steam/smoke wisps',
      'jammed_panini_press — panini press with burning food; smoke',
      'commercial_deep_fryer — overheated fryer; flame + smoke + lava; light 12',
      'overloaded_microwave — faculty-pantry microwave on a runaway cycle; sparks + smoke → Class C fire',
      'bunsen_burner_station — science-lab bunsen burner left running; open flame + soul flame',
      'reagent_storage_shelf — tipped, leaking reagent bottle; fumes + water drip; widest failure radius (2 blocks)',
      'overloaded_breaker_panel — utility-corridor panel over rated load; dense electric sparks → Class C fire',
      'overheating_wall_aircon — wall aircon leaking condensation into wiring; water drip + sparks',
      'jammed_laser_printer — faculty printer jammed against the fuser; smoke',
      'unattended_shrine_candle — lobby shrine candle beside altar cloth; flame + smoke, light 10 — fastest-failing hazard (250 ticks)',
      'leaking_gas_valve — cafeteria LPG line, Class F/K kitchen hazard; gas haze → flash fire',
      'alcohol_dispenser_station — hallway sanitizer stand leaking near an outlet; vapor wisps → blue flash fire',
      'clogged_exhaust_fan — dust-caked kitchen/workshop exhaust fan; smoke + ash from a stalled motor'
    ],
    notes: [
      'Set hazardous state with /setblock: e.g. /setblock ~ ~ ~ berongsmp:plastic_trash_bin[hazardous=true]',
      'The five kitchen hazards (unattended_grease_pan, grease_clogged_hood, contaminated_kitchen_bin, jammed_panini_press, commercial_deep_fryer) plus leaking_gas_valve can only be defused with the wet chemical extinguisher — ABC and CO2 refuse them and print a "wrong extinguisher" warning.',
      'All blocks are registered in the "BerongSMP — Hazard Props" creative tab.'
    ]
  },
  {
    name: '/item get',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/item get <name>',
    arguments: [
      { name: 'name', type: 'word', range: 'see ModItems.ALL_ITEM_MAP', required: 'Yes', description: 'Registry name of any custom BerongSMP item. Tab-completes all 83 names — the full catalog, a superset of /item hazard.' }
    ],
    description: 'Gives any custom BerongSMP item by registry name — extinguishers, hazard wand, computer, fire alarm, NPC spawners, furniture, safety items, and all 30 hazard props in one lookup.',
    whenToUse: [
      'Grabbing a single specific item without hunting for its dedicated /get_* command.',
      'Use "/item get hazard_wand" to grab the dev state-testing tool (right-click toggles a hazard prop between normal/hazardous, shift+right-click forces failure).'
    ],
    notes: [
      'Differs from /item hazard only in which lookup map it draws from — get covers all 83 items, hazard covers just the 30 hazard-prop blocks (a subset).',
      'example_block and example_item (template leftovers) are registered but deliberately excluded from ALL_ITEM_MAP — not obtainable via /item get or /item kit.'
    ]
  },
  {
    name: '/item kit',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/item kit',
    description: 'Gives one of every custom BerongSMP item at once (all 83 entries in ALL_ITEM_MAP), for quick full-scene dev testing.',
    whenToUse: [
      'Setting up a dev inventory to test every extinguisher, furniture block, hazard prop, safety-equipment block, and safety item in one shot.'
    ],
    notes: [
      'Chat: "Gave one of every BerongSMP item (83)."',
      'Make sure you have enough free inventory slots before running this.'
    ]
  },
  {
    name: '/spawn_lspu',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/spawn_lspu',
    description: 'Spawns the LSPU Library NBT structure at your current position for inspection.',
    whenToUse: [
      'Dev/admin: placing the library at an arbitrary location.',
      'Testing structure generation without a full simulation.'
    ],
    notes: [
      'Permanent world modification — not restored by /sim_stop.',
      'Use /sim_fire library for a full session that restores the arena on end.'
    ]
  },
  {
    name: '/place_buildings',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/place_buildings',
    description: 'Places every building in SimulationManager.BUILDINGS at their fixed world-space origins (LSPU Library, SSC Building, CCS Admin Building).',
    whenToUse: [
      'Manually re-placing/restoring all simulation structures at their canonical positions without running a full drill.',
      'Recovering the world after manual edits corrupted a structure.'
    ]
  },
  {
    name: '/spawn_npc',
    category: 'utility',
    permission: 'Op Level 2+',
    permissionLevel: 'admin',
    syntax: '/spawn_npc <type>',
    arguments: [
      { name: 'type', type: 'word', range: 'every NpcType.values() id', required: 'Yes', description: 'Which NPC role to spawn (e.g. sgt_reyes, sgt_santos, officer_cruz, capt_morfe, security_tuazon, dm_orlanda, necookie, sir_bookmark, student). Tab-completes.' }
    ],
    description: 'Spawns a CustomNpcEntity of the given type at your position, facing you.',
    whenToUse: [
      'Rebuilding a broken/missing NPC spot without re-running a full structure placement.',
      'Testing a specific NPC\'s dialogue role in isolation.'
    ],
    notes: ['Player-only.']
  }
];

// Config data
const configs = [
  { key: 'simDurationTicks', default: '2400', affects: 'How long any simulation runs (2 min)' },
  { key: 'fireSpawnCount', default: '3', affects: 'Fire blocks placed per fireSpawnInterval' },
  { key: 'fireSpawnInterval', default: '20 ticks', affects: 'How often fire is placed (1 s)' },
  { key: 'quakeBreakCount', default: '2', affects: 'Blocks destroyed per quake interval' },
  { key: 'quakeInterval', default: '10 ticks', affects: 'How often earthquake effect fires' },
  { key: 'simAreaSize', default: '25', affects: 'XZ arena radius for random fire/quake effects' },
  { key: 'simAreaHeight', default: '10', affects: 'Y arena height for random effects' },
  { key: 'quakeMagnitude', default: '5.0', affects: 'Default magnitude for /sim_earthquake library with no arg (ccs always rolls random 6.0–9.5)' },
  { key: 'quakeDecayRate', default: '0.05', affects: 'Intensity falloff per block of distance from epicenter' },
  { key: 'quakeRumbleDuration', default: '200 ticks', affects: 'Length of RUMBLE phase (10 s)' },
  { key: 'quakePeakDuration', default: '900 ticks', affects: 'Length of PEAK phase (45 s)' },
  { key: 'quakeAftershockDuration', default: '300 ticks', affects: 'Length of each AFTERSHOCK wave (15 s); 2–4 waves follow' },
  { key: 'bfpAdminPin', default: '""', affects: 'PIN for /bfp login — empty string disables PIN auth (OP-only); set a PIN before going live' },
  { key: 'tursoUrl', default: '""', affects: 'Turso HTTPS database URL for session tracking' },
  { key: 'tursoToken', default: '""', affects: 'Turso Bearer auth token' },
  { key: 'passThresholdFire', default: '5', affects: 'Fires extinguished required to mark a session as passed' },
  { key: 'academyGoStopGraceTicks', default: '30 ticks', affects: 'Reaction window after Officer Cruz calls STOP (1.5 s) — movement during it is never punished' },
  { key: 'academyPassThreshold', default: '70', affects: 'Minimum score (0–100) Capt. Morfe requires to certify a player after the Academy' },
  { key: 'academyIgniteDemoTicks', default: '200 ticks', affects: 'No longer enforced as a timeout (as of 2026-07-06) — Sgt. Reyes\'s ignite demo fire only goes out after 5s of accumulated rolling. Kept in config to avoid breaking existing config files.' }
];
---

<DashboardLayout title="Commands Reference" currentPath="/commands">
  <!-- Page Header -->
  <div class="page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="page-title">Commands Reference</h1>
      <p class="page-meta">Registered by ModCommands.java · hot-reloadable server configuration</p>
    </div>
    <!-- Search Bar -->
    <div class="search-container">
      <span class="material-symbols-outlined search-icon">search</span>
      <input
        type="text"
        id="command-search"
        placeholder="Search commands, syntax, keywords..."
        autocomplete="off"
      />
    </div>
  </div>

  <!-- Filter & Statistics Bar -->
  <div class="filter-bar">
    <div class="filter-group">
      <span class="filter-label">Categories</span>
      <div class="filter-pills" id="category-filters">
        <button class="filter-pill active" data-category="all">ALL</button>
        <button class="filter-pill" data-category="registration">REGISTRATION</button>
        <button class="filter-pill" data-category="simulation">SIMULATION</button>
        <button class="filter-pill" data-category="earthquake">EARTHQUAKE</button>
        <button class="filter-pill" data-category="bfp-admin">BFP ADMIN</button>
        <button class="filter-pill" data-category="academy">ACADEMY</button>
        <button class="filter-pill" data-category="utility">UTILITY</button>
      </div>
    </div>
    <div class="filter-count">
      Showing <span id="filtered-count" class="count-highlight">{commands.length}</span> of {commands.length} commands
    </div>
  </div>

  <!-- Main Grid Content -->
  <div class="commands-grid">
    <!-- Left Column: Command Cards List -->
    <div class="commands-list-pane">
      <div id="no-results-message" class="no-results hidden">
        <span class="material-symbols-outlined" style="font-size: 36px; margin-bottom: 8px;">search_off</span>
        <p>No commands matched your search criteria.</p>
      </div>

      {commands.map((cmd) => (
        <div
          class="command-card stone-border"
          data-name={cmd.name}
          data-category={cmd.category}
          data-keywords={`${cmd.name} ${cmd.description} ${cmd.syntax} ${cmd.permission} ${cmd.notes?.join(' ') || ''} ${cmd.whenToUse?.join(' ') || ''}`}
        >
          <!-- Card Header -->
          <div class="card-header">
            <div class="flex items-center justify-between">
              <span class="command-name">{cmd.name}</span>
              <span class={`perm-badge ${cmd.permissionLevel}`}>
                {cmd.permission}
              </span>
            </div>
            <div class="syntax-wrapper mt-3">
              <code class="syntax-code">{cmd.syntax}</code>
              <button class="copy-btn" data-syntax={cmd.syntax} title="Copy Syntax">
                <span class="material-symbols-outlined icon">content_copy</span>
                <span class="label">Copy</span>
              </button>
            </div>
          </div>

          <!-- Card Body -->
          <div class="card-body">
            <p class="description">{cmd.description}</p>

            {cmd.arguments && (
              <div class="args-section mt-4">
                <span class="sub-label">Arguments</span>
                <div class="table-container mt-1">
                  <table class="args-table">
                    <thead>
                      <tr>
                        <th>Arg</th>
                        <th>Type</th>
                        <th>Range</th>
                        <th>Req.</th>
                        <th>Description</th>
                      </tr>
                    </thead>
                    <tbody>
                      {cmd.arguments.map((arg) => (
                        <tr>
                          <td><code>{arg.name}</code></td>
                          <td><code>{arg.type}</code></td>
                          <td><span class="range-span">{arg.range}</span></td>
                          <td><span class={`req-span ${arg.required.toLowerCase() === 'yes' ? 'req-yes' : 'req-no'}`}>{arg.required}</span></td>
                          <td class="arg-desc">{arg.description}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <!-- Collapsible details toggle -->
            <button class="details-toggle mt-4">
              <span>View Details</span>
              <span class="material-symbols-outlined toggle-icon">expand_more</span>
            </button>

            <!-- Collapsible details content -->
            <div class="details-content hidden-height">
              <div class="details-inner pt-3">
                {cmd.whenToUse && (
                  <div class="detail-block">
                    <span class="sub-label">When to use:</span>
                    <ul>
                      {cmd.whenToUse.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {cmd.whatHappens && (
                  <div class="detail-block">
                    <span class="sub-label">What happens:</span>
                    <ol>
                      {cmd.whatHappens.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ol>
                  </div>
                )}

                {cmd.details && (
                  <div class="detail-block">
                    <span class="sub-label">{cmd.detailsLabel ?? 'Information printed:'}</span>
                    <ul>
                      {cmd.details.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {cmd.examples && (
                  <div class="detail-block">
                    <span class="sub-label">Example flow:</span>
                    <div class="example-box">
                      {cmd.examples.map((ex) => (
                        <div class="example-item">
                          <code class="example-cmd">{ex.cmd}</code>
                          <span class="example-desc">← {ex.desc}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {cmd.notes && (
                  <div class="detail-block">
                    <span class="sub-label">Notes:</span>
                    <ul class="notes-list">
                      {cmd.notes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Right Column: Config Defaults & Items -->
    <div class="config-pane flex flex-col gap-6">
      <!-- Items Card -->
      <div class="config-card stone-border">
        <div class="config-header">
          <span class="material-symbols-outlined flex-shrink-0" style="color: var(--text-brand)">inventory_2</span>
          <div>
            <h2 class="config-title">Vanilla Items & Blocks</h2>
            <p class="config-meta">Obtain items via <code>/give</code> or <code>/item get</code></p>
          </div>
        </div>
        <div class="config-body">
          <p class="config-desc mb-4">
            All BerongSMP items and blocks are obtainable via the vanilla <code>/give</code> command using namespaced IDs, or via <code>/item get &lt;name&gt;</code> / <code>/item kit</code> (see Utility commands, left).
          </p>

          <span class="sub-label mb-2">Simulation Items</span>
          <table class="config-table mb-4">
            <thead>
              <tr>
                <th>Item / Block</th>
                <th>Namespaced ID</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Fire Extinguisher</strong></td>
                <td><code class="cfg-key">berongsmp:fire_extinguisher</code></td>
                <td class="cfg-affects">Class A/B extinguisher. Right-click to pull pin, then hold to spray. Also: <code>/get_extinguisher</code></td>
              </tr>
              <tr>
                <td><strong>CO2 Extinguisher</strong></td>
                <td><code class="cfg-key">berongsmp:co2_extinguisher</code></td>
                <td class="cfg-affects">Class C extinguisher. Targets <code>BURNING</code> computer blocks. Also: <code>/get_co2_extinguisher</code></td>
              </tr>
              <tr>
                <td><strong>Wet Chemical Extinguisher</strong></td>
                <td><code class="cfg-key">berongsmp:wet_chemical_extinguisher</code></td>
                <td class="cfg-affects">Yellow Class F/K extinguisher for kitchen grease fires. Also: <code>/get_wet_chemical_extinguisher</code></td>
              </tr>
              <tr>
                <td><strong>Hazard Wand</strong></td>
                <td><code class="cfg-key">berongsmp:hazard_wand</code></td>
                <td class="cfg-affects">Dev tool. Right-click a hazard prop to toggle normal/hazardous; shift+right-click to force failure immediately.</td>
              </tr>
              <tr>
                <td><strong>Computer</strong></td>
                <td><code class="cfg-key">berongsmp:computer</code></td>
                <td class="cfg-affects">Placeable; right-click ON/OFF; flint &amp; steel to ignite (BURNING state).</td>
              </tr>
              <tr>
                <td><strong>Fire Alarm</strong></td>
                <td><code class="cfg-key">berongsmp:fire_alarm</code></td>
                <td class="cfg-affects">Wall-mounted alarm. Right-click during active FIRE simulation to activate and log a telemetry event.</td>
              </tr>
            </tbody>
          </table>

          <span class="sub-label mb-2">Safety Response Items</span>
          <table class="config-table mb-4">
            <thead>
              <tr>
                <th>Item</th>
                <th>Namespaced ID</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Fire Blanket</strong></td>
                <td><code class="cfg-key">berongsmp:fire_blanket</code></td>
                <td class="cfg-affects">One-shot: use while on fire clears fire ticks instantly; use on a hazardous kitchen prop smothers it. 3 uses.</td>
              </tr>
              <tr>
                <td><strong>First Aid Kit</strong></td>
                <td><code class="cfg-key">berongsmp:first_aid_kit</code></td>
                <td class="cfg-affects">Heals 3 hearts, clears negative effects, brief Slowness ("treatment time"). 5 uses.</td>
              </tr>
              <tr>
                <td><strong>Megaphone</strong></td>
                <td><code class="cfg-key">berongsmp:megaphone</code></td>
                <td class="cfg-affects">Instructor tool (OP 2+): broadcasts evacuation chat + klaxon to all players within 30 blocks, 5s cooldown.</td>
              </tr>
              <tr>
                <td><strong>Safety Whistle</strong></td>
                <td><code class="cfg-key">berongsmp:safety_whistle</code></td>
                <td class="cfg-affects">Loud positional ping + particle burst overhead, for group drills ("on me!"); 2s cooldown.</td>
              </tr>
              <tr>
                <td><strong>Flashlight</strong></td>
                <td><code class="cfg-key">berongsmp:flashlight</code></td>
                <td class="cfg-affects">60s of Night Vision — staying oriented in smoke/blackout scenes.</td>
              </tr>
              <tr>
                <td><strong>Firefighter Uniform</strong></td>
                <td><code class="cfg-key">berongsmp:firefighter_helmet</code> / <code>_coat</code> / <code>_pants</code> / <code>_boots</code></td>
                <td class="cfg-affects">Custom armor set (own ArmorMaterial), full 4-piece suit.</td>
              </tr>
            </tbody>
          </table>

          <span class="sub-label mb-2">Safety-Equipment Blocks</span>
          <table class="config-table mb-4">
            <thead>
              <tr>
                <th>Block</th>
                <th>Namespaced ID</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Exit Sign</strong></td>
                <td><code class="cfg-key">berongsmp:exit_sign</code></td>
                <td class="cfg-affects">Always-lit green EXIT sign (light level 7); wayfinding decor readable in a blackout scene.</td>
              </tr>
              <tr>
                <td><strong>Smoke Detector</strong></td>
                <td><code class="cfg-key">berongsmp:smoke_detector</code></td>
                <td class="cfg-affects">Ceiling detector; SafetyDeviceManager alarms it (red LED + beep) when fire is within 8 blocks during FIRE sessions.</td>
              </tr>
