---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ErrorCard from '../components/ErrorCard.astro';
import { getRosterStats, getRosterCount, getRosterCohortSummary, getDistinctSections, formatDate, derivePrepLevel } from '../lib/queries';
import { getEnv } from '../lib/db';

const env = await getEnv();
const hasDb = !!env;

const sp = Astro.url.searchParams;

const pageParam = sp.get('page');
let page = pageParam ? parseInt(pageParam, 10) : 1;
if (isNaN(page) || page < 1) page = 1;

const q       = sp.get('q') ?? '';
const section = sp.get('section') ?? 'ALL';
const sort    = sp.get('sort') ?? 'avg-score';
const dir: 'asc' | 'desc' = sp.get('dir') === 'asc' ? 'asc' : 'desc';

const limit = 25;
const offset = (page - 1) * limit;

function pageHref(p: number): string {
  const next = new URLSearchParams(sp);
  next.set('page', String(p));
  return `?${next.toString()}`;
}

let stats: Awaited<ReturnType<typeof getRosterStats>> = [];
let sections: string[] = [];
let dbError: string | null = null;
let matchedTotal = 0;
let cohort = { totalStudents: 0, totalSessions: 0, cohortAvg: 0, highCount: 0, modCount: 0, lowCount: 0 };

if (env) {
  try {
    const filters = { q, section, sort, dir };
    [matchedTotal, stats, sections, cohort] = await Promise.all([
      getRosterCount(env, filters),
      getRosterStats(env, filters, limit, offset),
      getDistinctSections(env),
      getRosterCohortSummary(env),
    ]);
  } catch (err) {
    dbError = err instanceof Error ? err.message : 'Unknown database error';
  }
}

const totalTiers = cohort.highCount + cohort.modCount + cohort.lowCount || 1;
const totalPages = Math.max(1, Math.ceil(matchedTotal / limit));
const isFiltered = q.trim() !== '' || section !== 'ALL';
// GROUP BY only ever yields rows with session_count >= 1, so this is always 0 —
// kept as an explicit KPI tile rather than fetched data.
const pendingCount = 0;

function sortClass(key: string): string {
  if (key !== sort) return '';
  return dir === 'asc' ? 'sorted-asc' : 'sorted-desc';
}
---

<DashboardLayout title="Roster" currentPath="/roster">

  <div class="page-header">
    <h1 class="page-title">Roster</h1>
    <p class="page-meta">
      {cohort.totalStudents} students · {cohort.totalSessions} sessions · cohort avg {cohort.cohortAvg}% · {hasDb ? (dbError ? '⚠ DB error' : 'live data') : '⚠ no DB'}
    </p>
  </div>

  {dbError && <ErrorCard message={dbError} />}

  <div class="kpi-strip">
    {([['HIGH', cohort.highCount], ['MODERATE', cohort.modCount], ['LOW', cohort.lowCount]] as const).map(([lvl, count]) => {
      const pct = Math.round((count / totalTiers) * 100);
      return (
        <div class="kpi-item">
          <span class="kpi-label">Best: {lvl}</span>
          <span class={`kpi-value tier-num-${lvl.toLowerCase()}`}>{count}</span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-brand-sub);">{pct}% of students</span>
        </div>
      );
    })}
    <div class="kpi-item">
      <span class="kpi-label">No sessions</span>
      <span class="kpi-value" style="color:var(--text-brand-sub);">{pendingCount}</span>
      <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-brand-sub);">pending</span>
    </div>
  </div>

  <div class="dist-section">
    <div class="dist-head">
      <span class="section-label">Cohort distribution (best session)</span>
      <span class="dist-cohort">{cohort.totalStudents} students</span>
    </div>
    <div class="dist-bar">
      {([['HIGH', cohort.highCount], ['MODERATE', cohort.modCount], ['LOW', cohort.lowCount]] as const).map(([lvl, count]) => {
        const pct = Math.round((count / totalTiers) * 100);
        return <div class={`dist-seg ${lvl.toLowerCase()}`} style={`width: ${pct}%`}></div>;
      })}
    </div>
    <div class="dist-legend">
      {([['HIGH', cohort.highCount], ['MODERATE', cohort.modCount], ['LOW', cohort.lowCount]] as const).map(([lvl, count]) => {
        const pct = Math.round((count / totalTiers) * 100);
        return (
          <div class="dist-leg-item">
            <span class={`leg-dot ${lvl.toLowerCase()}`}></span>
            <span class={`leg-tier ${lvl.toLowerCase()}`}>{lvl}</span>
            <span class="leg-count">{count} students · {pct}%</span>
          </div>
        );
      })}
    </div>
  </div>

  <div class="filter-bar">
    {sections.length > 0 && (
      <div class="filter-group">
        <span class="filter-label">Section</span>
        <div class="filter-pills" id="filter-section">
          <button class={`filter-pill ${section === 'ALL' ? 'active' : ''}`} data-value="ALL">All</button>
          {sections.map(sec => (
            <button class={`filter-pill ${section === sec ? 'active' : ''}`} data-value={sec}>{sec}</button>
          ))}
        </div>
      </div>
    )}
    <div class="filter-group" style="margin-left: auto;">
      <div class="search-wrapper">
        <span class="material-symbols-outlined search-icon" style="font-size: 15px; line-height: 1;">search</span>
        <input type="text" id="search-input" placeholder="Search student, ID, section..." class="search-input" value={q} />
      </div>
    </div>
    <span class="filter-count" id="roster-count">{matchedTotal} student{matchedTotal !== 1 ? 's' : ''}</span>
  </div>

  <div class="sessions-section">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:16px;">
      <span class="section-label">Students</span>
    </div>

    {stats.length === 0 ? (
      <p style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--text-muted); padding:24px 0;">
        {!hasDb
          ? 'Configure TURSO_URL and TURSO_TOKEN to see live data.'
          : isFiltered
            ? 'No students match the selected filters.'
            : 'No completed sessions yet.'}
      </p>
    ) : (
      <>
        <div class="table-scroll-wrap">
        <table class="sessions-table roster-table">
          <thead>
            <tr>
              <th class={`sortable ${sortClass('student')}`} data-sort-key="student">Student</th>
              <th class={`sortable ${sortClass('id')}`} data-sort-key="id">ID</th>
              <th class={`sortable ${sortClass('section')}`} data-sort-key="section">Section</th>
              <th class={`sortable ${sortClass('sessions')}`} data-sort-key="sessions">Sessions</th>
              <th class={`sortable ${sortClass('avg-score')}`} data-sort-key="avg-score">Avg score</th>
              <th class={`sortable ${sortClass('best-score')}`} data-sort-key="best-score">Best score</th>
              <th class={`sortable ${sortClass('passed')}`} data-sort-key="passed">Passed</th>
              <th class={`sortable ${sortClass('level')}`} data-sort-key="level">Best level</th>
              <th class={`sortable ${sortClass('last-active')}`} data-sort-key="last-active">Last active</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {stats.map(s => {
              const lvl = s.best_prep_level
                ? derivePrepLevel(Number(s.best_score), s.best_prep_level)
                : 'PENDING';
              return (
                <tr
                  onclick={s.latest_session_id ? `window.location='/sessions/${s.latest_session_id}'` : undefined}
                  style={s.latest_session_id ? 'cursor:pointer;' : ''}
                >
                  <td class="name-cell">{s.student_name}</td>
                  <td class="td-mono-muted">{s.student_id ?? '—'}</td>
                  <td class="td-mono-muted">{s.section ?? '—'}</td>
                  <td class="td-mono-muted">{s.session_count}</td>
                  <td>
                    {Number(s.session_count) > 0 ? (
                      <span class="td-score">
                        {s.avg_score}
                      </span>
                    ) : (
                      <span class="td-no-data">—</span>
                    )}
                  </td>
                  <td class="td-score">
                    {Number(s.session_count) > 0 ? s.best_score : '—'}
                  </td>
                  <td class="td-mono-muted">
                    {s.pass_count} / {s.session_count}
                  </td>
                  <td>
                    {lvl !== 'PENDING' ? (
                      <span class={`tier-badge ${lvl.toLowerCase()}`}>
                        <span class="dot"></span>
                        {lvl}
                      </span>
                    ) : (
                      <span class="td-no-data">—</span>
                    )}
                  </td>
                  <td class="td-mono-id">
                    {s.latest_start ? formatDate(s.latest_start) : '—'}
                  </td>
                  <td class="link-cell">
                    {s.latest_session_id && (
                      <a href={`/sessions/${s.latest_session_id}`} class="view-link" onclick="event.stopPropagation()">→</a>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {totalPages > 1 && (
        <div class="pagination">
          <a
            href={page > 1 ? pageHref(page - 1) : '#'}
            class={`pagination-btn ${page <= 1 ? 'disabled' : ''}`}
            aria-disabled={page <= 1}
          >
            &larr; Prev
          </a>
          <span class="pagination-info">
            Page <strong>{page}</strong> of <strong>{totalPages}</strong>
          </span>
          <a
            href={page < totalPages ? pageHref(page + 1) : '#'}
            class={`pagination-btn ${page >= totalPages ? 'disabled' : ''}`}
            aria-disabled={page >= totalPages}
          >
            Next &rarr;
          </a>
        </div>
      )}
      </>
    )}

    <p class="roster-note">
      Clicking a row opens the student's most recent session. Best level is based on highest prep_level across all sessions.
    </p>
  </div>

</DashboardLayout>

<script>
  import { initServerSort, updateQueryParams, debounce } from '../lib/tableQueryParams';

  initServerSort('avg-score', 'desc');

  const secGroup    = document.getElementById('filter-section');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

  if (secGroup) {
    secGroup.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        updateQueryParams({ section: pill.dataset.value! });
      });
    });
  }

  if (searchInput) {
    const debouncedSearch = debounce((value: string) => {
      updateQueryParams({ q: value.trim() || null });
    }, 400);
    searchInput.addEventListener('input', () => debouncedSearch(searchInput.value));
  }
</script>
