---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ErrorCard from '../../components/ErrorCard.astro';
import { getSessionsPage, getSessionCount, formatDuration, formatDate, derivePrepLevel } from '../../lib/queries';
import { getEnv } from '../../lib/db';

const env = await getEnv();
const hasDb = !!env;

const sp = Astro.url.searchParams;

const pageParam = sp.get('page');
let page = pageParam ? parseInt(pageParam, 10) : 1;
if (isNaN(page) || page < 1) page = 1;

const q     = sp.get('q') ?? '';
const type  = sp.get('type') ?? 'ALL';
const level = sp.get('level') ?? 'ALL';
const sort  = sp.get('sort') ?? 'date';
const dir: 'asc' | 'desc' = sp.get('dir') === 'asc' ? 'asc' : 'desc';

const limit = 25;
const offset = (page - 1) * limit;

function pageHref(p: number): string {
  const next = new URLSearchParams(sp);
  next.set('page', String(p));
  return `?${next.toString()}`;
}

let sessions: Awaited<ReturnType<typeof getSessionsPage>>['rows'] = [];
let matchedTotal = 0;
let totalSessions = 0;
let dbError: string | null = null;

if (env) {
  try {
    totalSessions = await getSessionCount(env);
    const result = await getSessionsPage(env, { q, type, level, sort, dir }, limit, offset);
    sessions = result.rows;
    matchedTotal = result.total;
  } catch (err) {
    dbError = err instanceof Error ? err.message : 'Unknown database error';
  }
}

const totalPages = Math.max(1, Math.ceil(matchedTotal / limit));
const isFiltered = q.trim() !== '' || type !== 'ALL' || level !== 'ALL';

function sortClass(key: string): string {
  if (key !== sort) return '';
  return dir === 'asc' ? 'sorted-asc' : 'sorted-desc';
}
---

<DashboardLayout title="Sessions" currentPath="/sessions">

  <div class="page-header">
    <h1 class="page-title">Sessions</h1>
    <p class="page-meta">All drill sessions · {totalSessions} records · {hasDb ? (dbError ? '⚠ DB error' : 'live data') : '⚠ no DB'}</p>
  </div>

  {dbError && <ErrorCard message={dbError} />}

  <div class="filter-bar">
    <div class="filter-group">
      <span class="filter-label">Scenario</span>
      <div class="filter-pills" id="filter-type">
        <button class={`filter-pill ${type === 'ALL' ? 'active' : ''}`} data-value="ALL">All</button>
        <button class={`filter-pill ${type === 'FIRE' ? 'active' : ''}`} data-value="FIRE">Fire</button>
        <button class={`filter-pill ${type === 'EARTHQUAKE' ? 'active' : ''}`} data-value="EARTHQUAKE">Earthquake</button>
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Level</span>
      <div class="filter-pills" id="filter-level">
        <button class={`filter-pill ${level === 'ALL' ? 'active' : ''}`} data-value="ALL">All</button>
        <button class={`filter-pill ${level === 'HIGH' ? 'active' : ''}`} data-value="HIGH">High</button>
        <button class={`filter-pill ${level === 'MODERATE' ? 'active' : ''}`} data-value="MODERATE">Moderate</button>
        <button class={`filter-pill ${level === 'LOW' ? 'active' : ''}`} data-value="LOW">Low</button>
      </div>
    </div>
    <div class="filter-group" style="margin-left: auto;">
      <div class="search-wrapper">
        <span class="material-symbols-outlined search-icon" style="font-size: 15px; line-height: 1;">search</span>
        <input type="text" id="search-input" placeholder="Search student, ID, section..." class="search-input" value={q} />
      </div>
    </div>
    <span class="filter-count" id="session-count">{matchedTotal} session{matchedTotal !== 1 ? 's' : ''}</span>
  </div>

  <div class="sessions-section">
    {sessions.length === 0 ? (
      <p class="td-no-data" style="padding:24px 0; text-align:center;">
        {!hasDb
          ? 'Configure TURSO_URL and TURSO_TOKEN to see live data.'
          : isFiltered
            ? 'No sessions match the selected filters.'
            : 'No sessions yet.'}
      </p>
    ) : (
      <>
        <div id="bulk-toolbar" class="bulk-toolbar" style="display:none;">
          <span class="bulk-toolbar-info"><span id="bulk-select-count">0</span> sessions selected</span>
          <button id="btn-bulk-delete" class="btn-bulk-delete">Delete Selected</button>
        </div>

        <div class="table-scroll-wrap">
          <table class="sessions-table" id="sessions-table">
            <thead>
              <tr>
                <th class="checkbox-col"><input type="checkbox" id="check-all" /></th>
                <th class={`sortable ${sortClass('id')}`} data-sort-key="id">ID</th>
                <th class={`sortable ${sortClass('student')}`} data-sort-key="student">Student</th>
                <th class={`sortable ${sortClass('section')}`} data-sort-key="section">Section</th>
                <th class={`sortable ${sortClass('scenario')}`} data-sort-key="scenario">Scenario</th>
                <th class={`sortable ${sortClass('date')}`} data-sort-key="date">Date</th>
                <th class={`sortable ${sortClass('duration')}`} data-sort-key="duration">Duration</th>
                <th class={`sortable ${sortClass('score')}`} data-sort-key="score">Score</th>
                <th class={`sortable ${sortClass('level')}`} data-sort-key="level">Level</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {sessions.map(s => {
                const lvl = derivePrepLevel(s.simulation_score, s.prep_level);
                return (
                  <tr onclick={`window.location='/sessions/${s.id}'`}>
                    <td class="checkbox-col" onclick="event.stopPropagation()">
                      <input type="checkbox" class="row-check" data-id={s.id} />
                    </td>
                    <td class="td-mono-id">
                      {s.id}
                    </td>
                    <td class="name-cell">{s.student_name}</td>
                    <td class="td-mono-muted">{s.section ?? '—'}</td>
                    <td>
                      <span class={s.simulation_type === 'FIRE' ? 'td-type-fire' : 'td-type-quake'}>
                        {s.simulation_type ?? '—'}
                      </span>
                    </td>
                    <td class="td-mono-muted">{formatDate(s.start_time)}</td>
                    <td class="td-mono-muted">{formatDuration(s.start_time, s.end_time)}</td>
                    <td class="td-score">
                      {s.simulation_score}
                    </td>
                    <td>
                      {lvl !== 'PENDING' ? (
                        <span class={`tier-badge ${lvl.toLowerCase()}`}>
                          <span class="dot"></span>
                          {lvl}
                        </span>
                      ) : (
                        <span class="td-pending">PENDING</span>
                      )}
                    </td>
                    <td class="link-cell">
                      <a href={`/sessions/${s.id}`} class="view-link" onclick="event.stopPropagation()">→</a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <div class="pagination">
            <a
              href={page > 1 ? pageHref(page - 1) : '#'}
              class={`pagination-btn ${page <= 1 ? 'disabled' : ''}`}
              aria-disabled={page <= 1}
            >
              &larr; Prev
            </a>
            <span class="pagination-info">
              Page <strong>{page}</strong> of <strong>{totalPages}</strong>
            </span>
            <a
              href={page < totalPages ? pageHref(page + 1) : '#'}
              class={`pagination-btn ${page >= totalPages ? 'disabled' : ''}`}
              aria-disabled={page >= totalPages}
            >
              Next &rarr;
            </a>
          </div>
        )}
      </>
    )}
  </div>

</DashboardLayout>

<script>
  import { initServerSort, updateQueryParams, debounce } from '../../lib/tableQueryParams';

  initServerSort('date', 'desc');

  const typeGroup   = document.getElementById('filter-type');
  const levelGroup  = document.getElementById('filter-level');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

  function bindPills(group: HTMLElement, paramKey: string) {
    group.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        updateQueryParams({ [paramKey]: pill.dataset.value! });
      });
    });
  }

  if (typeGroup)  bindPills(typeGroup, 'type');
  if (levelGroup) bindPills(levelGroup, 'level');

  if (searchInput) {
    const debouncedSearch = debounce((value: string) => {
      updateQueryParams({ q: value.trim() || null });
    }, 400);
    searchInput.addEventListener('input', () => debouncedSearch(searchInput.value));
  }

  // Bulk Actions
  const checkAll = document.getElementById('check-all') as HTMLInputElement | null;
  const rowChecks = document.querySelectorAll('.row-check');
  const bulkToolbar = document.getElementById('bulk-toolbar');
  const bulkSelectCount = document.getElementById('bulk-select-count');
  const btnBulkDelete = document.getElementById('btn-bulk-delete');

  function updateBulkToolbar() {
    const checkedRows = document.querySelectorAll('.row-check:checked');
    const count = checkedRows.length;
    if (bulkToolbar && bulkSelectCount) {
      if (count > 0) {
        bulkToolbar.style.display = 'flex';
        bulkSelectCount.textContent = count.toString();
      } else {
        bulkToolbar.style.display = 'none';
      }
    }
    if (checkAll) {
      const allChecked = rowChecks.length > 0 && Array.from(rowChecks).every(c => (c as HTMLInputElement).checked);
      const someChecked = count > 0 && count < rowChecks.length;
      checkAll.checked = allChecked;
      checkAll.indeterminate = someChecked;
    }
  }

  if (checkAll) {
    checkAll.addEventListener('change', () => {
      rowChecks.forEach(check => {
        (check as HTMLInputElement).checked = checkAll.checked;
      });
      updateBulkToolbar();
    });
  }

  rowChecks.forEach(check => {
    check.addEventListener('change', updateBulkToolbar);
  });

  if (btnBulkDelete) {
    btnBulkDelete.addEventListener('click', async () => {
      const checkedRows = document.querySelectorAll('.row-check:checked');
      const ids = Array.from(checkedRows).map(c => Number((c as HTMLInputElement).dataset.id));
      if (ids.length === 0) return;

      const confirmMsg = `Are you sure you want to delete the selected ${ids.length} session(s)? This action cannot be undone.`;
      if (!confirm(confirmMsg)) return;

      try {
        btnBulkDelete.setAttribute('disabled', 'true');
        btnBulkDelete.textContent = 'Deleting...';

        const res = await fetch('/api/sessions/bulk-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const errData = await res.json() as { error?: string };
          alert(`Failed to delete sessions: ${errData.error || 'Unknown error'}`);
          btnBulkDelete.removeAttribute('disabled');
          btnBulkDelete.textContent = 'Delete Selected';
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred while deleting sessions.');
        btnBulkDelete.removeAttribute('disabled');
        btnBulkDelete.textContent = 'Delete Selected';
      }
    });
  }
</script>
