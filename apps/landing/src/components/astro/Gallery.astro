---
// Gallery.astro – "Visual Logs" section: the AVP (Audio-Visual Presentation) video
const avpVideoUrl = 'https://res.cloudinary.com/vozl5cld/video/upload/v1784464661/Berong-Smp-Avp-optimized_mxpoto.mp4';
// Cloudinary auto-derives a JPG poster frame from the same public ID.
const avpPosterUrl = avpVideoUrl.replace(/\.mp4$/, '.jpg');
---

<section
  class="py-24 relative"
  id="gallery"
  aria-labelledby="gallery-heading"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <!-- Section header row -->
    <div class="flex justify-between items-end mb-12 border-b border-border-stone pb-4 reveal-heading">
      <h2
        id="gallery-heading"
        class="pixel-heading--sm"
      >
        Visual Logs
      </h2>
      <a
        href="#"
        class="font-mono text-xs font-medium text-primary hover:underline flex items-center gap-1"
        aria-label="View full image archive (coming soon)"
      >
        View Archive
        <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">
          arrow_forward
        </span>
      </a>
    </div>

    <!-- AVP video showcase -->
    <figure class="stone-border bg-surface-container p-2 relative overflow-hidden group reveal" data-avp-figure>
      <div
        class="absolute inset-0 bg-gradient-to-t from-surface-deep via-transparent to-transparent z-10 opacity-60 pointer-events-none transition-opacity duration-300"
        data-avp-gradient
        aria-hidden="true"
      ></div>
      <video
        data-avp-video
        class="w-full h-full object-cover min-h-[300px] md:min-h-[560px] bg-black"
        poster={avpPosterUrl}
        preload="metadata"
        playsinline
        loop
      >
        <source src={avpVideoUrl} type="video/mp4" />
        Your browser does not support embedded video.
      </video>
      <span class="pill-tag absolute top-4 left-4 z-20">AVP</span>

      <!-- Play affordance — click starts playback and hands off to native controls -->
      <button
        type="button"
        data-avp-play
        aria-label="Play the Audio-Visual Presentation"
        class="absolute inset-0 z-20 flex items-center justify-center transition-opacity duration-300 cursor-pointer"
      >
        <span class="w-16 h-16 rounded-full bg-black/60 border-2 border-white/80 flex items-center justify-center backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
          <span class="material-symbols-outlined text-white" style="font-size:32px; font-variation-settings:'FILL' 1;">play_arrow</span>
        </span>
      </button>

      <figcaption data-avp-caption class="absolute bottom-6 left-6 z-20 pointer-events-none transition-opacity duration-300">
        <p class="font-headline text-sm font-semibold text-white m-0">Audio-Visual Presentation</p>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const figure = document.querySelector<HTMLElement>('[data-avp-figure]');
  const video = figure?.querySelector<HTMLVideoElement>('[data-avp-video]');
  const playBtn = figure?.querySelector<HTMLButtonElement>('[data-avp-play]');
  const gradient = figure?.querySelector<HTMLElement>('[data-avp-gradient]');
  const caption = figure?.querySelector<HTMLElement>('[data-avp-caption]');

  if (video && playBtn) {
    const start = () => {
      video.controls = true;
      video.play();
      playBtn.style.display = 'none';
      gradient?.classList.add('opacity-0');
      caption?.classList.add('opacity-0');
    };
    playBtn.addEventListener('click', start);
  }
</script>
